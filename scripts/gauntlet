#!/usr/bin/env bash
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
for py in "${HOME}/.orc-venv/bin/python" "${root}/.venv/bin/python"; do
  if [ -x "$py" ]; then
    cd "$root"
    exec "$py" -m gauntlet "$@"
  fi
done
echo "No gauntlet venv. Run ./scripts/cloud-agent-install.sh" >&2
exit 1
